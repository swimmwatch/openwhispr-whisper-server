# Paths are resolved relative to deploy/compose.yaml; this file only interpolates
# Compose. Both services explicitly read the mounted application JSON file.
WHISPER_API_IMAGE=whisper-api:local
WHISPER_BACKEND_IMAGE=whisper-backend:local
# Registry overrides select BOTH references from the same immutable release:
# ghcr.io/swimmwatch/openwhispr-whisper-server-{api,backend}:<version>
# docker.io/swimmwatch/openwhispr-whisper-server-{api,backend}:<version>
WHISPER_CONFIG_FILE=../internal/platform/config/defaults.json
# Create this directory first, including for the download/cache recipe.
# Prepared-file configuration uses /prepared/<file> and downloadSet: [].
# Prepared files and their parent directories must be readable by UID 10001.
WHISPER_PREPARED_DIR=../.local/compose/prepared
WHISPER_GPU_DEVICE_ID=0
WHISPER_BIND_ADDRESS=127.0.0.1
# Host publication is independent of the API's container listener.
WHISPER_API_PORT=8080
# Match api.port and backend.port in WHISPER_CONFIG_FILE respectively.
# Also set api.backendUrl to http://backend:<backend.port> in that JSON.
# These values wire Compose publication/probes; they do not override the JSON.
WHISPER_API_CONTAINER_PORT=8080
WHISPER_BACKEND_CONTAINER_PORT=8081
# Must be >= timeouts.shutdownSeconds + timeouts.cleanupSeconds + 5 seconds.
WHISPER_STOP_GRACE=45s
# Recreate BOTH containers after configuration changes. Preserve model-cache;
# ordinary teardown uses down without --volumes. P09 provides final recipes.
